# Server Configuration
PORT=5000
NODE_ENV="production"

# Database (Neon PostgreSQL)
# DATABASE_URL: Pooled connection string (-pooler in host, port 5432) used by Prisma at runtime
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/point001?sslmode=require"
# DIRECT_URL: Direct unpooled connection string used for Prisma migrations (prisma migrate deploy)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/point001?sslmode=require"

# Security & Authentication
JWT_SECRET="generate_a_long_random_jwt_secret_key_minimum_32_characters"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# CORS Allowed Origins (Comma-separated for local + production Vercel frontend)
CLIENT_URL="https://point001.vercel.app,http://localhost:5173"

# Google Integration (Optional for profile sync & Google Contacts)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

